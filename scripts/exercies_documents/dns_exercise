```jsx
	#!/bin/bash
	
	# Ensure the script is run as root
	if [ "$EUID" -ne 0 ]; then
	  echo "Error: This script must be run as root."
	  exit 1
	fi
	
	# Variables
	zone="nick-maharjan.sasm.uclllabs.be"
	parent_zonefile="/etc/bind/zones/db.$zone"
	configfile="/etc/bind/named.conf.yoda-zones"
	zone_dir="/etc/bind/zones"
	
	# Function to remove a zone
	remove_zone() {
	  local subzone="$1"
	  local zonefile="$zone_dir/db.$subzone.$zone"
	
	  # Remove NS record from the parent zone
	  sed -i "/$subzone\s\+IN\s\+NS\s\+/d" "$parent_zonefile"
	
	  # Remove the zone configuration from named.conf.yoda-zones
	  sed -i "/zone \"$subzone.$zone\" {/,/};/d" "$configfile"
	
	  # Remove the zone file
	  rm -f "$zonefile"
	
	  echo "Removed zone: $subzone.$zone"
	}
	
	# Get the current timestamp
	current_time=$(date +%s)
	
	# Find and remove zones older than 4 hours
	for zonefile in "$zone_dir"/db.*.$zone; do
	  if [ -f "$zonefile" ]; then
	    subzone=$(basename "$zonefile" | sed "s/db.//" | sed "s/\.$zone//")
	    creation_time=$(stat -c %Y "$zonefile")
	    age=$((current_time - creation_time))
	
	    if [ "$age" -gt 14400 ]; then # 4 hours = 14400 seconds
	      remove_zone "$subzone"
	    fi
	  fi
	done
	
	# Update serial number in the parent zone file
	current_serial=$(grep -m 1 "Serial" "$parent_zonefile" | awk '{print $1}')
	new_serial=$(date +%Y%m%d%H)
	sed -i "s/$current_serial/$new_serial/" "$parent_zonefile"
	
	# Reload BIND to apply changes
	if systemctl restart bind9; then
	  echo "BIND reloaded successfully."
	else
	  echo "Error: Failed to reload BIND. Please check the configuration."
	  exit 1
	fi
