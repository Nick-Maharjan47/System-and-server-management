## **Scripting Part**

### **http_add_vhost Script**

I created the script file:

```bash
sudo nano /etc/scripts/http_add_vhost

```

I added the following script:

```bash
#!/bin/bash

# Function to display usage
usage() {
    echo "Usage: sudo $0 <subdomain>.nick-maharjan.sasm.uclllabs.be"
    exit 1
}

# Check if the script is run with sudo privileges
if [[ $EUID -ne 0 ]]; then
    echo "Error: This script must be run with sudo privileges."
    exit 1
fi

# Validate the number of arguments
if [[ $# -ne 1 ]]; then
    usage
fi

FQDN=$1

# Validate FQDN ends with 'nick-maharjan.sasm.uclllabs.be'
if [[ $FQDN != *.nick-maharjan.sasm.uclllabs.be ]]; then
    echo "Error: FQDN must end with 'nick-maharjan.sasm.uclllabs.be'."
    exit 1
fi

# Define paths
DOC_ROOT="/var/www/$FQDN"
VHOST_CONF="/etc/apache2/sites-available/$FQDN.conf"
LOG_FILE="/var/log/apache2/$FQDN.log"

# Create the DocumentRoot directory
if ! mkdir -p "$DOC_ROOT"; then
    echo "Error: Failed to create directory $DOC_ROOT." | tee -a "$LOG_FILE"
    exit 1
fi

# Extract the subdomain part
SUBDOMAIN="${FQDN%.nick-maharjan.sasm.uclllabs.be}"

# Create a default index.html page with the subdomain part
echo "welcome $SUBDOMAIN" > "$DOC_ROOT/index.html"

if [[ $? -ne 0 ]]; then
    echo "Error: Failed to create index.html in $DOC_ROOT." | tee -a "$LOG_FILE"
    exit 1
fi

# Create the Virtual Host configuration
cat <<EOL > "$VHOST_CONF"
<VirtualHost *:80>
    ServerName $FQDN
    DocumentRoot $DOC_ROOT

    <Directory $DOC_ROOT>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog \${APACHE_LOG_DIR}/${FQDN}_error.log
    CustomLog \${APACHE_LOG_DIR}/${FQDN}_access.log combined
</VirtualHost>
EOL

if [[ $? -ne 0 ]]; then
    echo "Error: Failed to create virtual host configuration at $VHOST_CONF." | tee -a "$LOG_FILE"
    exit 1
fi

# Enable the new Virtual Host
if ! a2ensite "$FQDN.conf"; then
    echo "Error: Failed to enable site $FQDN." | tee -a "$LOG_FILE"
    exit 1
fi

# Reload Apache to apply changes
if ! systemctl restart apache2; then
    echo "Error: Failed to reload Apache." | tee -a "$LOG_FILE"
    exit 1
fi

# Add DNS record
PARENT_DOMAIN="nick-maharjan.sasm.uclllabs.be"
IP_ADDRESS="193.191.176.212"

# Add the specified subdomain to the DNS
/etc/scripts/dns_add_record -t A "$SUBDOMAIN" "$IP_ADDRESS" "$PARENT_DOMAIN"

if [[ $? -ne 0 ]]; then
    echo "Error: Failed to add DNS record for $SUBDOMAIN.$PARENT_DOMAIN." | tee -a "$LOG_FILE"
    exit 1
fi

echo "Virtual host for $FQDN successfully created and enabled." | tee -a "$LOG_FILE"

```

