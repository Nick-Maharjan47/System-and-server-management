        # after it has been globally disabled with "a2disconf".
        #Include conf-available/serve-cgi-bin.conf
</VirtualHost>

# This is for the https as it uses 443
<VirtualHost *:443>
    ServerName www.nick-maharjan.sasm.uclllabs.be
    DocumentRoot /var/www/html
    SSLEngine on
    SSLCertificateFile /root/.acme.sh/nick-maharjan.sasm.uclllabs.be_ecc/nick-maharjan.sasm.uclllabs.be.cer
    SSLCertificateKeyFile /root/.acme.sh/nick-maharjan.sasm.uclllabs.be_ecc/nick-maharjan.sasm.uclllabs.be.key
 </VirtualHost>

add 
```

Next, I edited the **HTTPS** virtual host file to ensure the SSL certificates were configured correctly. I opened the relevant file:

```bash
bash
Copy code
sudo nano /etc/apache2/sites-available/secure.nick-maharjan.sasm.uclllabs.be.conf

```

Then, I updated the `<VirtualHost *:443>` block like this:

```
  GNU nano 7.2                                                    secure.nick-maharjan.sasm.uclllabs.be.conf                                                              <VirtualHost *:80>
    ServerName secure.nick-maharjan.sasm.uclllabs.be
    DocumentRoot /var/www/html
    Redirect permanent / https://secure.nick-maharjan.sasm.uclllabs.be/
</VirtualHost>

<VirtualHost *:443>
    ServerName secure.nick-maharjan.sasm.uclllabs.be
    DocumentRoot /var/www/html

    SSLEngine on
    SSLCertificateFile /etc/pki/fullchain.pem
    SSLCertificateKeyFile /etc/pki/nick-maharjan.sasm.uclllabs.be.key

    <IfModule mod_rewrite.c>
        RewriteEngine on
        RewriteCond %{HTTPS} off
        RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>
</VirtualHost>

```

